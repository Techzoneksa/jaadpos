generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  STARTER
  GROWTH
  PRO
}

enum TenantStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum RoleKey {
  PLATFORM_OWNER
  PLATFORM_STAFF
  TENANT_OWNER
  BRANCH_MANAGER
  CASHIER
  ACCOUNTANT
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum AddonRequirement {
  OPTIONAL
  REQUIRED
}

enum AddonSelectionType {
  SINGLE
  MULTIPLE
}

enum OrderStatus {
  DRAFT
  HELD
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  MADA
  VISA_MASTERCARD
  APPLE_PAY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum RefundType {
  FULL
  PARTIAL
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EInvoiceMode {
  BASIC_QR_ONLY
}

enum ZatcaIntegrationStatus {
  NOT_ENABLED
  COMING_SOON
  ADVANCED_ADDON
}

model Plan {
  id            String         @id @default(cuid())
  code          PlanCode       @unique
  nameArabic    String
  nameEnglish   String
  monthlyPrice  Decimal        @default(0) @db.Decimal(10, 2)
  maxBranches   Int
  maxPosDevices Int
  maxUsers      Int
  features      Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenants       Tenant[]
  subscriptions Subscription[]
}

model Tenant {
  id                     String                   @id @default(cuid())
  name                   String
  legalName              String?
  vatNumber              String?
  commercialRegistration String?
  city                   String?
  address                String?
  phone                  String?
  email                  String?
  status                 TenantStatus             @default(ACTIVE)
  onboardingCompleted    Boolean                  @default(false)
  planId                 String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  plan                   Plan                     @relation(fields: [planId], references: [id])
  subscription           Subscription?
  users                  User[]
  branches               Branch[]
  posDevices             PosDevice[]
  roles                  Role[]
  categories             Category[]
  products               Product[]
  addons                 Addon[]
  taxSettings            TaxSetting?
  invoiceSettings        InvoiceSetting?
  orders                 Order[]
  orderItems             OrderItem[]
  invoices               Invoice[]
  payments               Payment[]
  refunds                Refund[]
  refundItems            RefundItem[]
  shifts                 Shift[]
  auditLogs              AuditLog[]
}

model Subscription {
  id              String             @id @default(cuid())
  tenantId        String             @unique
  planId          String
  status          SubscriptionStatus @default(TRIAL)
  trialStartedAt  DateTime
  trialEndsAt     DateTime
  activeStartedAt DateTime?
  cancelledAt     DateTime?
  pastDueAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            Plan               @relation(fields: [planId], references: [id])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String?
  key             RoleKey
  nameArabic      String
  createdAt       DateTime         @default(now())
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  branchId     String?
  email        String     @unique
  passwordHash String
  name         String
  role         RoleKey
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?    @relation(fields: [branchId], references: [id])
  orders       Order[]
  refunds      Refund[]
  shifts       Shift[]
  auditLogs    AuditLog[]

  @@index([tenantId, role])
}

model Branch {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  city       String?
  address    String?
  phone      String?
  isMain     Boolean     @default(false)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users      User[]
  devices    PosDevice[]
  orders     Order[]
  shifts     Shift[]
}

model PosDevice {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    Order[]
  shifts    Shift[]

  @@unique([tenantId, code])
}

model TaxSetting {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  defaultTaxRate   Decimal  @default(0.15) @db.Decimal(5, 4)
  pricesIncludeTax Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InvoiceSetting {
  id                     String                 @id @default(cuid())
  tenantId               String                 @unique
  logoUrl                String?
  footerText             String?
  qrEnabled              Boolean                @default(true)
  invoicePrefix          String?                @default("INV")
  invoiceNumberFormat    String?                @default("YYYY-00000")
  eInvoiceMode           EInvoiceMode           @default(BASIC_QR_ONLY)
  zatcaIntegrationStatus ZatcaIntegrationStatus @default(NOT_ENABLED)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Category {
  id          String         @id @default(cuid())
  tenantId    String
  nameArabic  String
  nameEnglish String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  addons      Addon[]

  @@index([tenantId, status])
}

model Product {
  id               String         @id @default(cuid())
  tenantId         String
  categoryId       String
  nameArabic       String
  nameEnglish      String?
  price            Decimal        @db.Decimal(10, 2)
  pricesIncludeTax Boolean        @default(false)
  taxRate          Decimal        @default(0.15) @db.Decimal(5, 4)
  sku              String?
  imageUrl         String?
  status           ProductStatus  @default(ACTIVE)
  available        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category       @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  productAddons    ProductAddon[]

  @@index([tenantId, categoryId, status])
}

model Addon {
  id             String             @id @default(cuid())
  tenantId       String
  categoryId     String?
  name           String
  price          Decimal            @default(0) @db.Decimal(10, 2)
  requirement    AddonRequirement   @default(OPTIONAL)
  selectionType  AddonSelectionType @default(SINGLE)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?          @relation(fields: [categoryId], references: [id])
  productAddons  ProductAddon[]
}

model ProductAddon {
  productId String
  addonId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([productId, addonId])
}

model Shift {
  id             String      @id @default(cuid())
  tenantId       String
  branchId       String
  deviceId       String
  cashierId      String
  status         ShiftStatus @default(OPEN)
  openingFloat   Decimal     @default(0) @db.Decimal(10, 2)
  closingCash    Decimal?    @db.Decimal(10, 2)
  cashDifference Decimal?    @db.Decimal(10, 2)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id])
  device         PosDevice   @relation(fields: [deviceId], references: [id])
  cashier        User        @relation(fields: [cashierId], references: [id])
  orders         Order[]

  @@index([tenantId, status])
}

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  branchId       String
  deviceId       String
  cashierId      String
  shiftId        String
  orderNumber    String
  orderType      OrderType
  status         OrderStatus @default(DRAFT)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  subtotal       Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @default(0) @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id])
  device         PosDevice   @relation(fields: [deviceId], references: [id])
  cashier        User        @relation(fields: [cashierId], references: [id])
  shift          Shift       @relation(fields: [shiftId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  invoice        Invoice?
  refunds        Refund[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  productId      String?
  productName    String
  quantity       Decimal  @db.Decimal(10, 3)
  unitPrice      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  taxRate        Decimal  @default(0.15) @db.Decimal(5, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal  @db.Decimal(10, 2)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
  refundItems    RefundItem[]

  @@index([tenantId, orderId])
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  orderId   String
  method    PaymentMethod
  status    PaymentStatus @default(PAID)
  amount    Decimal       @db.Decimal(10, 2)
  paidAt    DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  invoiceNumber  String
  invoiceStatus  InvoiceStatus @default(PAID)
  issuedAt       DateTime      @default(now())
  sellerName     String
  sellerVatNumber String
  qrPayload      String
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  footerText     String?
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds        Refund[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issuedAt])
}

model Refund {
  id          String      @id @default(cuid())
  tenantId    String
  invoiceId   String
  orderId     String
  userId      String
  type        RefundType
  reason      String
  amount      Decimal     @db.Decimal(10, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  order       Order       @relation(fields: [orderId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  items       RefundItem[]

  @@index([tenantId, createdAt])
}

model RefundItem {
  id          String    @id @default(cuid())
  tenantId    String
  refundId    String
  orderItemId String
  productName String
  quantity    Decimal   @db.Decimal(10, 3)
  amount      Decimal   @db.Decimal(10, 2)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}
